# Cloudflare static assets.
# Next.js fingerprints these file names, so they can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Open Graph images are exported without a file extension.
/opengraph-image
  Content-Type: image/png
/blog/*/opengraph-image
  Content-Type: image/png
