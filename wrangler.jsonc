{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: no script runs, so requests are free and
  // unlimited on Cloudflare's free plan. `npm run build` writes `out/`.
  "name": "gymledger-site",
  "compatibility_date": "2026-10-27",
  // Cloudflare creates the DNS records and certificates for these. The site
  // lives on www; the bare domain is redirected there by a Redirect Rule on
  // the getgymledger.com zone.
  "routes": [
    { "pattern": "www.getgymledger.com", "custom_domain": true },
    { "pattern": "getgymledger.com", "custom_domain": true }
  ],
  // Serve only on the real domains, so no duplicate copy gets indexed.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    // `/blog` is served from `out/blog.html`, keeping today's URLs unchanged.
    "html_handling": "auto-trailing-slash",
    // Serve the exported `out/404.html` with a 404 status.
    "not_found_handling": "404-page"
  }
}
